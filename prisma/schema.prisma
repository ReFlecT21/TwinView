// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  STARTUP
  SME
  MNC
  ENTERPRISE
  CORPORATION
  LLC
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
  NON_PROFIT
  GOVERNMENT
  PUBLIC_COMPANY
  PRIVATE_COMPANY
  UNICORN
  SCALE_UP
  FAMILY_BUSINESS
  COOPERATIVE
  JOINT_VENTURE
  SUBSIDIARY
  HOLDING_COMPANY
  CONSULTANCY
  FREELANCER
  OTHER
}

model Company {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                 String
  type                 CompanyType?  @default(OTHER)
  industry             String
  country              String
  employees            Int?
  revenue              String?
  headquarters         String?
  ceo                  String?
  founded              Int?
  website              String?
  businessAreas        String[]      @default([])
  digitalTwinStatus    String        @default("not_started")
  digitalTwinMaturity  Int           @default(0)
  opportunityScore     Int           @default(0)
  estimatedDealValue   String?
  lastUpdated          DateTime?     @default(now())
  nextFollowUp         DateTime?
  notes                String?
  competitiveAnalysis  String?
  dellOpportunity      String?
  digitalTwinStrategy  String?
  // Structured components data
  painPoints           Json     @default("[]")
  dellSolutions        Json     @default("[]")
  nextSteps            Json     @default("[]")
  competitors          Json     @default("[]")
  dellAdvantages       Json     @default("[]")
  threats              Json     @default("[]")
  differentiation      Json     @default("[]")
  winStrategy          Json     @default("[]")
  personnel            Json     @default("[]")

  // Digital Twin Value Chain fields
  valueChainStages     ValueChainStage[]  @default([])
  primaryValueChainStage ValueChainStage?
  dellProductsUsed     Json               @default("[]") // Array of DellProduct IDs
  technologyStack      Json               @default("{}") // Tech stack by value chain stage
  valueChainMaturity   Json               @default("{}") // Maturity score per stage
  partnerEcosystem     Json               @default("[]") // Partner IDs by stage

  activityLogs   ActivityLog[]
  newsMatches    NewsCompanyMatch[]
  companyDellProducts CompanyDellProduct[]

  @@map("companies")
}

model ActivityLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  companyId   String?   @db.VarChar
  userId      String
  userName    String
  action      String
  description String
  timestamp   DateTime? @default(now())

  company     Company?  @relation(fields: [companyId], references: [id])

  @@map("activity_logs")
}

model TeamMember {
  id         String    @id @db.VarChar  // This will be the Clerk user ID
  name       String
  email      String    @unique
  role       String?
  department String?
  joinedAt   DateTime? @default(now())

  @@map("team_members")
}

enum ISVVertical {
  manufacturing
  smart_cities
  healthcare
}

enum ISVSize {
  startup
  small
  medium
  large
  enterprise
}

enum ISVMaturityStage {
  Early
  Growth
  Mature
  Leader
}

enum ISVInterestLevel {
  high
  medium
  low
  growing
}

enum ISVRegion {
  APAC
  EMEA
  Americas
}

// Digital Twin Value Chain Stages
enum ValueChainStage {
  DATA_CAPTURE_INGESTION
  EDGE_PROCESSING
  STORAGE_MANAGEMENT
  COMPUTE_SIMULATION
  VISUALIZATION_DECISION
}

// Dell Product Categories aligned with Value Chain
enum DellProductCategory {
  // Data Capture & Ingestion
  NATIVE_EDGE_GATEWAYS
  IOT_CONNECT

  // Edge Processing
  POWEREDGE_XE
  EDGE_SERVERS

  // Storage & Management
  POWER_SCALE
  POWERSTORE
  POWERPROTECT

  // Compute & Simulation
  POWEREDGE_GPU
  AI_FACTORY
  OMNIVERSE_NVIDIA

  // Visualization & Decision
  CLOUD_INTEGRATION
  DISPLAYS
  ANALYTICS_PLATFORM
}

model ISVStartup {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                    String
  vertical                ISVVertical

  // Geographic Info
  headquarters            String?
  presence                String[]            @default([])
  regions                 ISVRegion[]         @default([])
  coordinates             Json?

  // Size & Scale
  size                    ISVSize?
  maturityStage           ISVMaturityStage?
  employees               Int?
  accounts                Int?
  revenue                 String?

  // Openness & Compatibility
  hasOpenAPIs             Boolean             @default(false)
  integrations            String[]            @default([])
  dellValidated           Boolean             @default(false)
  consortiumMemberships   String[]            @default([])
  certifications          String[]            @default([])

  // Interest & Strategic Value
  interestLevel           ISVInterestLevel?
  interestReasons         String[]            @default([])
  caseStudies             Json                @default("[]")
  strategicValue          String?

  // Partnership Potential
  matchedPartners         String[]            @default([])
  synergyScores           Json                @default("{}")
  collaborationTypes      String[]            @default([])

  // Digital Twin Value Chain fields
  valueChainStages        ValueChainStage[]  @default([])
  primaryValueChainStage  ValueChainStage?
  dellProductsSupported   Json               @default("[]") // Dell products this ISV supports
  technologyOffering      Json               @default("{}") // Technologies offered by stage
  valueChainCapabilities  Json               @default("{}") // Capabilities per stage
  integrationPoints       Json               @default("[]") // Integration points with Dell stack
  products                Json               @default("[]") // ISV's own products/solutions
  solutionsByStage        Json               @default("{}") // Solutions mapped to value chain stages

  // Metadata
  notes                   String?
  createdAt               DateTime?           @default(now())
  updatedAt               DateTime?           @default(now())

  isvDellProducts         ISVDellProduct[]

  @@map("isv_startups")
}

enum NewsSourceType {
  NEWS_ARTICLE
  PRESS_RELEASE
  BLOG
  RESEARCH_PAPER
  SOCIAL_MEDIA
  OTHER
}

model NewsArticle {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  title         String
  content       String          @db.Text
  summary       String?         @db.Text
  url           String          @unique
  sourceType    NewsSourceType  @default(NEWS_ARTICLE)
  sourceName    String
  author        String?
  imageUrl      String?
  publishedAt   DateTime
  fetchedAt     DateTime        @default(now())
  keywords      String[]        @default([])

  // Relationships
  companyMatches NewsCompanyMatch[]

  @@index([publishedAt])
  @@index([sourceType])
  @@map("news_articles")
}

model NewsCompanyMatch {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  newsArticleId   String       @db.VarChar
  companyId       String       @db.VarChar
  relevanceScore  Float        @default(1.0)
  matchReason     String?      // e.g., "Company name mentioned 3 times"
  isRead          Boolean      @default(false)
  notifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  // Relationships
  newsArticle     NewsArticle  @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([newsArticleId, companyId])
  @@index([companyId, isRead])
  @@index([createdAt])
  @@map("news_company_matches")
}

enum DigestFrequency {
  DAILY
  WEEKLY
  DISABLED
}

model UserNotificationPreferences {
  id              String          @id @db.VarChar  // Clerk user ID
  digestFrequency DigestFrequency @default(DAILY)
  lastDigestSent  DateTime?
  emailEnabled    Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("user_notification_preferences")
}

// Dell Products Model
model DellProduct {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name              String
  category          DellProductCategory
  valueChainStage   ValueChainStage
  description       String?             @db.Text
  features          String[]            @default([])
  specifications    Json                @default("{}")
  targetIndustries  String[]            @default([])
  useCases          Json                @default("[]")
  imageUrl          String?
  productUrl        String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relationships
  companyProducts   CompanyDellProduct[]
  isvProducts       ISVDellProduct[]

  @@index([category])
  @@index([valueChainStage])
  @@map("dell_products")
}

// Junction table for Company-DellProduct relationship
model CompanyDellProduct {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  companyId        String       @db.VarChar
  dellProductId    String       @db.VarChar
  adoptionStatus   String       @default("evaluating") // evaluating, piloting, deployed, production
  adoptionDate     DateTime?
  usageScale       String?      // small, medium, large, enterprise
  satisfaction     Int?         // 1-10 rating
  notes            String?

  // Relationships
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dellProduct      DellProduct  @relation(fields: [dellProductId], references: [id], onDelete: Cascade)

  @@unique([companyId, dellProductId])
  @@index([companyId])
  @@index([dellProductId])
  @@map("company_dell_products")
}

// Junction table for ISV-DellProduct relationship
model ISVDellProduct {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  isvId            String       @db.VarChar
  dellProductId    String       @db.VarChar
  integrationType  String       @default("compatible") // compatible, certified, optimized, native
  certificationDate DateTime?
  integrationLevel String?      // basic, advanced, deep, native
  apiSupport       Boolean      @default(false)
  documentation    String?
  notes            String?

  // Relationships
  isv              ISVStartup   @relation(fields: [isvId], references: [id], onDelete: Cascade)
  dellProduct      DellProduct  @relation(fields: [dellProductId], references: [id], onDelete: Cascade)

  @@unique([isvId, dellProductId])
  @@index([isvId])
  @@index([dellProductId])
  @@map("isv_dell_products")
}
