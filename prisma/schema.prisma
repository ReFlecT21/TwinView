// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  STARTUP
  SME
  MNC
  ENTERPRISE
  CORPORATION
  LLC
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
  NON_PROFIT
  GOVERNMENT
  PUBLIC_COMPANY
  PRIVATE_COMPANY
  UNICORN
  SCALE_UP
  FAMILY_BUSINESS
  COOPERATIVE
  JOINT_VENTURE
  SUBSIDIARY
  HOLDING_COMPANY
  CONSULTANCY
  FREELANCER
  OTHER
}

model Company {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                 String
  type                 CompanyType?  @default(OTHER)
  industry             String
  country              String
  employees            Int?
  revenue              String?
  headquarters         String?
  ceo                  String?
  founded              Int?
  website              String?
  businessAreas        String[]      @default([])
  digitalTwinStatus    String        @default("not_started")
  digitalTwinMaturity  Int           @default(0)
  opportunityScore     Int           @default(0)
  estimatedDealValue   String?
  lastUpdated          DateTime?     @default(now())
  nextFollowUp         DateTime?
  notes                String?
  competitiveAnalysis  String?
  dellOpportunity      String?
  digitalTwinStrategy  String?
  // Structured components data
  painPoints           Json     @default("[]")
  dellSolutions        Json     @default("[]")
  nextSteps            Json     @default("[]")
  competitors          Json     @default("[]")
  dellAdvantages       Json     @default("[]")
  threats              Json     @default("[]")
  differentiation      Json     @default("[]")
  winStrategy          Json     @default("[]")
  personnel            Json     @default("[]")

  activityLogs ActivityLog[]

  @@map("companies")
}

model ActivityLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  companyId   String?   @db.VarChar
  userId      String
  userName    String
  action      String
  description String
  timestamp   DateTime? @default(now())

  company     Company?  @relation(fields: [companyId], references: [id])

  @@map("activity_logs")
}

model TeamMember {
  id         String    @id @db.VarChar  // This will be the Clerk user ID
  name       String
  email      String    @unique
  role       String?
  department String?
  joinedAt   DateTime? @default(now())

  @@map("team_members")
}
