// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  STARTUP
  SME
  MNC
  ENTERPRISE
  CORPORATION
  LLC
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
  NON_PROFIT
  GOVERNMENT
  PUBLIC_COMPANY
  PRIVATE_COMPANY
  UNICORN
  SCALE_UP
  FAMILY_BUSINESS
  COOPERATIVE
  JOINT_VENTURE
  SUBSIDIARY
  HOLDING_COMPANY
  CONSULTANCY
  FREELANCER
  OTHER
}

model Company {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                 String
  type                 CompanyType?  @default(OTHER)
  industry             String
  country              String
  employees            Int?
  revenue              String?
  headquarters         String?
  ceo                  String?
  founded              Int?
  website              String?
  businessAreas        String[]      @default([])
  digitalTwinStatus    String        @default("not_started")
  digitalTwinMaturity  Int           @default(0)
  opportunityScore     Int           @default(0)
  estimatedDealValue   String?
  lastUpdated          DateTime?     @default(now())
  nextFollowUp         DateTime?
  notes                String?
  competitiveAnalysis  String?
  dellOpportunity      String?
  digitalTwinStrategy  String?
  // Structured components data
  painPoints           Json     @default("[]")
  dellSolutions        Json     @default("[]")
  nextSteps            Json     @default("[]")
  competitors          Json     @default("[]")
  dellAdvantages       Json     @default("[]")
  threats              Json     @default("[]")
  differentiation      Json     @default("[]")
  winStrategy          Json     @default("[]")
  personnel            Json     @default("[]")

  activityLogs   ActivityLog[]
  newsMatches    NewsCompanyMatch[]

  @@map("companies")
}

model ActivityLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  companyId   String?   @db.VarChar
  userId      String
  userName    String
  action      String
  description String
  timestamp   DateTime? @default(now())

  company     Company?  @relation(fields: [companyId], references: [id])

  @@map("activity_logs")
}

model TeamMember {
  id         String    @id @db.VarChar  // This will be the Clerk user ID
  name       String
  email      String    @unique
  role       String?
  department String?
  joinedAt   DateTime? @default(now())

  @@map("team_members")
}

enum ISVVertical {
  manufacturing
  smart_cities
  healthcare
}

enum ISVSize {
  startup
  small
  medium
  large
  enterprise
}

enum ISVMaturityStage {
  Early
  Growth
  Mature
  Leader
}

enum ISVInterestLevel {
  high
  medium
  low
  growing
}

enum ISVRegion {
  APAC
  EMEA
  Americas
}

model ISVStartup {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                    String
  vertical                ISVVertical

  // Geographic Info
  headquarters            String?
  presence                String[]            @default([])
  regions                 ISVRegion[]         @default([])
  coordinates             Json?

  // Size & Scale
  size                    ISVSize?
  maturityStage           ISVMaturityStage?
  employees               Int?
  accounts                Int?
  revenue                 String?

  // Openness & Compatibility
  hasOpenAPIs             Boolean             @default(false)
  integrations            String[]            @default([])
  dellValidated           Boolean             @default(false)
  consortiumMemberships   String[]            @default([])
  certifications          String[]            @default([])

  // Interest & Strategic Value
  interestLevel           ISVInterestLevel?
  interestReasons         String[]            @default([])
  caseStudies             Json                @default("[]")
  strategicValue          String?

  // Partnership Potential
  matchedPartners         String[]            @default([])
  synergyScores           Json                @default("{}")
  collaborationTypes      String[]            @default([])

  // Metadata
  notes                   String?
  createdAt               DateTime?           @default(now())
  updatedAt               DateTime?           @default(now())

  @@map("isv_startups")
}

enum NewsSourceType {
  NEWS_ARTICLE
  PRESS_RELEASE
  BLOG
  RESEARCH_PAPER
  SOCIAL_MEDIA
  OTHER
}

model NewsArticle {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  title         String
  content       String          @db.Text
  summary       String?         @db.Text
  url           String          @unique
  sourceType    NewsSourceType  @default(NEWS_ARTICLE)
  sourceName    String
  author        String?
  imageUrl      String?
  publishedAt   DateTime
  fetchedAt     DateTime        @default(now())
  keywords      String[]        @default([])

  // Relationships
  companyMatches NewsCompanyMatch[]

  @@index([publishedAt])
  @@index([sourceType])
  @@map("news_articles")
}

model NewsCompanyMatch {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  newsArticleId   String       @db.VarChar
  companyId       String       @db.VarChar
  relevanceScore  Float        @default(1.0)
  matchReason     String?      // e.g., "Company name mentioned 3 times"
  isRead          Boolean      @default(false)
  notifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  // Relationships
  newsArticle     NewsArticle  @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([newsArticleId, companyId])
  @@index([companyId, isRead])
  @@index([createdAt])
  @@map("news_company_matches")
}

enum DigestFrequency {
  DAILY
  WEEKLY
  DISABLED
}

model UserNotificationPreferences {
  id              String          @id @db.VarChar  // Clerk user ID
  digestFrequency DigestFrequency @default(DAILY)
  lastDigestSent  DateTime?
  emailEnabled    Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("user_notification_preferences")
}
